{
  "name": "@topologia-new/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:migrate": "tsx src/database/cli.ts apply",
    "db:status": "tsx src/database/cli.ts status",
    "test:db": "tsx --test --test-concurrency=1 test/database.test.ts",
    "test:auth": "tsx --test --test-concurrency=1 test/auth.test.ts",
    "test:access": "tsx --test --test-concurrency=1 test/access.test.ts",
    "admin:create": "tsx src/auth/admin-cli.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@topologia-new/domain": "0.1.0",
    "fastify": "5.12.5",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
